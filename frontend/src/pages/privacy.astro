---
import Base from "../layouts/Base.astro";
import { PLACEHOLDER, business, telHref } from "../data/business";
import { buildWhatsAppUrl } from "../lib/quote";

const whatsappHref = buildWhatsAppUrl(business.whatsapp, "Hi, please delete the messages about my quote.");
const email: string = business.email;
const headingClass = "mt-10 text-2xl tracking-tight md:text-3xl";
const paragraphClass = "mt-4 max-w-prose";
const linkClass = "inline-flex min-h-tap items-center font-semibold";
---

<Base
  title={`Privacy Policy | ${business.name}`}
  description={`How ${business.name} handles the details you send us by WhatsApp, text or phone, and how to ask us to delete them.`}
>
  <article class="mx-auto max-w-3xl px-4 py-10 md:px-8 md:py-16">
    <h1 class="text-4xl tracking-tight md:text-6xl">Privacy policy</h1>
    <p class="mt-4 max-w-prose text-lg">
      This page explains what happens to the details you give us when you ask {business.name} for a quote.
    </p>

    <h2 class={headingClass}>Who is responsible</h2>
    <p class={paragraphClass}>
      {business.name} is run by {business.owner}, a sole trader, and he is responsible for the details you send us. You
      can reach us on <a href={telHref} class={linkClass}>{business.phone.display}</a>, on
      <a href={whatsappHref} class={linkClass}>WhatsApp</a>
      {
        email === PLACEHOLDER ? (
          <span>or by email at {PLACEHOLDER}.</span>
        ) : (
          <span>
            or by email at <a href={`mailto:${email}`} class={linkClass}>{email}</a>.
          </span>
        )
      }
    </p>

    <h2 class={headingClass}>What the quote form asks for</h2>
    <p class={paragraphClass}>
      The quote form asks for your name, phone number, postcode, the service you need and a description of the job. We
      only use them to reply to you about that job. The site has no accounts and does not use cookies or analytics.
    </p>

    <h2 class={headingClass}>How your message reaches us</h2>
    <p class={paragraphClass}>
      The form does not send anything to us by itself. When you press "Send on WhatsApp", WhatsApp opens on your phone or
      computer with your message written out. Nothing is sent until you press send in WhatsApp, and then it goes from your
      WhatsApp to ours. WhatsApp is run by Meta, and its own privacy terms cover that conversation.
    </p>
    <p class={paragraphClass}>
      If you press "Send as a text", your messages app opens with the same message, and it goes through your mobile
      network when you send it. If you call us, the call goes through your phone provider like any other call.
    </p>

    <h2 class={headingClass}>What this site keeps</h2>
    <p class={paragraphClass}>
      This website does not store your details. The form works in your browser and keeps no copy of what you type.
      Microsoft Azure hosts the site and keeps the same standard request logs it does for any website.
    </p>

    <h2 class={headingClass}>Deleting a conversation</h2>
    <p class={paragraphClass}>
      Your message stays in our WhatsApp or text messages, and in your own WhatsApp or messages app. To ask us to delete
      the conversation about your quote, call us on <a href={telHref} class={linkClass}>{business.phone.display}</a> or
      send us a <a href={whatsappHref} class={linkClass}>WhatsApp message</a> asking for it to be deleted. You can delete
      your own copy at any time.
    </p>

    <h2 class={headingClass}>Your rights</h2>
    <p class={paragraphClass}>
      Under UK data protection law you can ask to see, correct or delete the details we hold about you. If you are unhappy
      with how we handle them, you can complain to the Information Commissioner's Office.
    </p>
  </article>
</Base>
