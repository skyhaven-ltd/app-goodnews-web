---
import Base from "../layouts/Base.astro";
import { business, telHref } from "../data/business";
import { homeLink, quoteLink } from "../data/navigation";

const primaryClass =
  "inline-flex min-h-tap items-center justify-center rounded-brand bg-navy px-6 py-3 font-heading font-bold uppercase text-ground no-underline";
const secondaryClass =
  "inline-flex min-h-tap items-center justify-center rounded-brand border-2 border-navy px-6 py-3 font-heading font-bold uppercase text-navy no-underline";
---

<Base
  title={`Page Not Found | ${business.name}`}
  description={`The page you asked for is not on the ${business.name} website. Head back to the home page, the services or the quote form.`}
  noindex
>
  <section class="bg-pale">
    <div class="mx-auto max-w-3xl px-4 py-14 md:px-8 md:py-24">
      <p class="font-heading text-sm font-bold uppercase tracking-[0.2em] text-accent">Error 404</p>
      <h1 class="mt-2 text-4xl tracking-tight md:text-6xl">Page not found</h1>
      <p class="mt-4 max-w-prose text-lg">
        That page does not exist or has moved. Try one of these instead, or call {business.ownerFirstName} on
        <a href={telHref} class="inline-flex min-h-tap items-center font-semibold">{business.phone.display}</a>.
      </p>
      <div class="mt-6 grid gap-3 sm:flex sm:flex-wrap">
        <a href={homeLink.href} class={primaryClass}>Home page</a>
        <a href="/services" class={secondaryClass}>Services</a>
        <a href={quoteLink.href} class={secondaryClass}>Get a quote</a>
      </div>
    </div>
  </section>
</Base>
