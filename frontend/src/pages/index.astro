---
import { Picture } from "astro:assets";
import "../styles/motion.css";
import Base from "../layouts/Base.astro";
import ProcessTrack, { type ProcessStep } from "../components/home/ProcessTrack.astro";
import BeforeAfter from "../components/home/BeforeAfter.astro";
import ServiceCard from "../components/ServiceCard.astro";
import { business, telHref } from "../data/business";
import { quoteLink } from "../data/navigation";
import { beforeAfterPairs, projectByFile } from "../data/projects";
import { leadServices, secondaryServices, serviceHref } from "../data/services";
import { areaHref, areas } from "../data/areas";
import { buildWhatsAppUrl } from "../lib/quote";

const hero = projectByFile("plastered-hallway.jpg");
const whatsappHref = buildWhatsAppUrl(business.whatsapp, `Hi ${business.ownerFirstName}, I'd like a quote.`);
const pair = beforeAfterPairs[0];

const services = [
  ...leadServices.map((service) => ({ service, href: serviceHref(service) })),
  ...secondaryServices.map((service) => ({ service, href: "/services" })),
];

const steps: ProcessStep[] = [
  { title: "Prepare", text: "Boards down and the room cleared before work starts.", file: "plastering-large-room.jpg" },
  { title: "Board", text: "New plasterboard fixed to walls and ceilings, ready to skim.", file: "plasterboarded-corridor.jpg" },
  { title: "Skim", text: "A smooth skim coat across walls and ceilings.", file: "plastered-stairwell.jpg" },
  { title: "Detail", text: "Panelling, mouldings and woodwork fitted.", file: "wall-panelling-in-progress.jpg" },
  { title: "Decorate", text: "Painted, tidied and handed back to you.", file: "finished-landing.jpg" },
].map(({ file, ...step }) => {
  const project = projectByFile(file);
  return { ...step, image: project.image, alt: project.alt };
});

const stats = [{ value: "25+", label: "years in the trade" }];

const eyebrowClass = "font-heading text-sm font-bold uppercase tracking-[0.2em] text-accent";
const sectionTitleClass = "text-3xl tracking-tight md:text-5xl";
const primaryClass =
  "inline-flex min-h-tap items-center justify-center rounded-brand bg-navy px-6 py-3 font-heading font-bold uppercase text-ground no-underline";
const secondaryClass =
  "inline-flex min-h-tap items-center justify-center gap-2 rounded-brand border-2 border-navy px-6 py-3 font-heading font-bold uppercase text-navy no-underline";
---

<Base
  title="Good News Plastering | Plastering, Painting & Decorating"
  description="Plastering, painting and decorating, and gardening across Birmingham, Worcestershire and Evesham."
  localBusiness={{}}
>
  <section id="hero" class="overflow-hidden bg-pale">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 pb-12 pt-6 md:grid-cols-2 md:items-center md:gap-12 md:px-8 md:py-20">
      <div class="min-w-0">
        <p class={eyebrowClass}>Birmingham · Worcestershire · Evesham</p>
        <h1 class="mt-3 text-[2.5rem] font-black leading-[0.95] tracking-tight sm:text-5xl lg:text-7xl">
          <span data-motion="skim">Plastering &amp; decorating</span>
          <span data-motion="skim" class="text-accent">you can trust</span>
        </h1>
        <div data-motion="fade">
          <p class="mt-4 max-w-prose text-lg md:mt-6 md:text-xl">
            {business.owner} has spent over 25 years plastering, decorating and putting homes back together. One tradesman, from
            quote to finish.
          </p>
          <div class="mt-5 grid gap-3 sm:flex sm:flex-wrap md:mt-8">
            <a href={quoteLink.href} data-motion="fill" class={primaryClass}>Get your free quote</a>
            <a href={whatsappHref} class={secondaryClass}>
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 21l1.65-3.8A9 9 0 1 1 7.8 20.3L3 21"></path>
              </svg>
              WhatsApp {business.ownerFirstName}
            </a>
          </div>
          <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2 font-semibold">
            {
              ["Free quotes", "25+ years' experience", "One tradesman, start to finish"].map((point) => (
                <li class="flex items-center gap-2">
                  <svg class="size-5 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12l5 5 9-10"></path>
                  </svg>
                  {point}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <div class="relative min-w-0">
        <Picture
          src={hero.image}
          alt={hero.alt}
          formats={["avif", "webp"]}
          widths={[480, 800, 1200]}
          sizes="(min-width: 72rem) 34rem, (min-width: 48rem) 50vw, 100vw"
          loading="eager"
          fetchpriority="high"
          class="aspect-[4/3] w-full rounded-brand object-cover md:aspect-[4/5]"
        />
        <div data-motion="fade" class="absolute bottom-4 left-4 flex items-center gap-3 rounded-brand bg-ground px-4 py-3 shadow-lg md:-left-4 md:bottom-7">
          <strong class="font-heading text-4xl font-black leading-none text-navy">25+</strong>
          <span class="font-semibold leading-tight text-navy">years<br />on the tools</span>
        </div>
      </div>
    </div>
  </section>

  <section id="services" class="mx-auto max-w-6xl px-4 py-14 md:px-8 md:py-24">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class={eyebrowClass}>What we do</p>
        <h2 class:list={[sectionTitleClass, "mt-2"]}>One call. Every trade.</h2>
      </div>
      <a href="/services" class="inline-flex min-h-tap items-center font-bold">All services</a>
    </div>
    <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map(({ service, href }) => (
          <li data-motion="rise">
            <ServiceCard service={service} href={href} />
          </li>
        ))
      }
    </ul>
  </section>

  <section id="process" class="bg-navy py-14 text-ground md:py-24">
    <div class="mx-auto flex max-w-6xl flex-wrap items-end justify-between gap-4 px-4 md:px-8">
      <h2 id="process-title" class:list={[sectionTitleClass, "text-ground"]}>How a job comes together</h2>
      <p class="text-pale">Real photos from {business.ownerFirstName}'s jobs. Swipe through the stages.</p>
    </div>
    <ProcessTrack labelledBy="process-title" steps={steps} />
  </section>

  {
    pair && (
      <section id="before-after" class="mx-auto max-w-6xl px-4 py-14 md:px-8 md:py-24">
        <div class="grid gap-8 md:grid-cols-[1fr_2fr] md:items-center md:gap-12">
          <div>
            <p class={eyebrowClass}>Drag to compare</p>
            <h2 class:list={[sectionTitleClass, "mt-2"]}>{pair.room}</h2>
            <a href="/projects" class="mt-4 inline-flex min-h-tap items-center font-bold">
              See every project
            </a>
          </div>
          <BeforeAfter before={pair.before} after={pair.after} />
        </div>
      </section>
    )
  }

  <section id="stats" aria-label={`Why choose ${business.ownerFirstName}`} class="bg-baby text-navy">
    <ul class="mx-auto grid max-w-6xl gap-6 px-4 py-12 md:px-8 md:py-16">
      {
        stats.map((stat) => (
          <li data-motion="rise">
            <strong class="block font-heading text-5xl font-black leading-none md:text-6xl">{stat.value}</strong>
            <span class="mt-2 block font-semibold">{stat.label}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="areas" class="mx-auto max-w-6xl px-4 py-14 md:px-8 md:py-24">
    <p class={eyebrowClass}>Areas covered</p>
    <h2 class:list={[sectionTitleClass, "mt-2"]}>Where {business.ownerFirstName} works</h2>
    <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
      {
        areas.map((area) => (
          <li>
            <a href={areaHref(area)} class="flex min-h-tap items-center rounded-brand bg-pale px-4 py-3 font-bold text-navy no-underline">
              {area.name}
            </a>
          </li>
        ))
      }
    </ul>
    <a href="/areas" class="mt-6 inline-flex min-h-tap items-center font-bold">More about the areas covered</a>
  </section>

  <section id="get-a-quote" class="bg-pale">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 py-14 md:grid-cols-2 md:items-center md:px-8 md:py-24">
      <h2 class="text-4xl tracking-tight md:text-6xl">
        Got a job?<br /><span class="text-accent">Get a free price.</span>
      </h2>
      <div>
        <ol class="grid gap-3">
          {
            [
              `Tell ${business.ownerFirstName} about the job`,
              "He replies by WhatsApp or phone",
              "Send photos on WhatsApp if it helps",
            ].map((step, index) => (
              <li class="flex items-center gap-3">
                <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-navy font-bold text-ground" aria-hidden="true">
                  {index + 1}
                </span>
                {step}
              </li>
            ))
          }
        </ol>
        <div class="mt-6 grid gap-3 sm:flex sm:flex-wrap">
          <a href={quoteLink.href} data-motion="fill" class={primaryClass}>Get your free quote</a>
          <a href={telHref} class={secondaryClass}>Call {business.phone.display}</a>
        </div>
      </div>
    </div>
  </section>
</Base>
