---
import Base from "../layouts/Base.astro";
---

<Base
  title="Good News Plastering | Plastering, Painting & Decorating"
  description="Plastering, painting and decorating, and gardening across Birmingham, Worcestershire and Evesham."
>
  <section class="bg-pale px-4 py-12 md:px-8 md:py-20">
    <div class="mx-auto max-w-5xl">
      <h1 class="text-4xl md:text-6xl">Good News Plastering</h1>
      <p class="mt-4 max-w-prose text-lg">
        Plastering, painting and decorating, and gardening across Birmingham, Worcestershire and Evesham.
      </p>
      <a
        href="/quote"
        class="mt-6 inline-flex min-h-tap items-center rounded-brand bg-navy px-6 font-heading font-bold uppercase text-ground no-underline"
      >
        Get a quote
      </a>
    </div>
  </section>
</Base>
