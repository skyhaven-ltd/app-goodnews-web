---
import Base from "../layouts/Base.astro";
import QuoteForm from "../components/QuoteForm.astro";
import { business, telHref } from "../data/business";
---

<Base
  title={`Get a Quote | ${business.name}`}
  description={`Ask ${business.name} for a quote for plastering, painting and decorating, gardening and more across Birmingham, Worcestershire and Evesham.`}
>
  <section id="quote" class="bg-pale px-4 py-10 md:px-8 md:py-16">
    <div class="mx-auto max-w-2xl">
      <h1 class="text-3xl md:text-5xl">Get a quote</h1>
      <p class="mt-4 max-w-prose text-lg">
        Tell us about the job and we'll get back to you on WhatsApp or by phone. Prefer to talk?
        Call <a href={telHref} class="inline-flex min-h-tap min-w-tap items-center font-semibold">{business.phone.display}</a>.
      </p>
      <div class="relative mt-8 rounded-brand bg-ground p-5 shadow-sm md:p-8">
        <QuoteForm />
      </div>
    </div>
  </section>
</Base>
