---
import Base from "../layouts/Base.astro";
import Gallery from "../components/Gallery.astro";
import { business, telHref } from "../data/business";
import { quoteLink } from "../data/navigation";
import { projects } from "../data/projects";

const eyebrowClass = "font-heading text-sm font-bold uppercase tracking-[0.2em] text-accent";
const primaryClass =
  "inline-flex min-h-tap items-center justify-center rounded-brand bg-navy px-6 py-3 font-heading font-bold uppercase text-ground no-underline";
const secondaryClass =
  "inline-flex min-h-tap items-center justify-center rounded-brand border-2 border-navy px-6 py-3 font-heading font-bold uppercase text-navy no-underline";
---

<Base
  title={`Projects | ${business.name}`}
  description="Photos from our plastering, decorating, carpentry, kitchen and garden jobs, taken on site."
>
  <section class="bg-pale">
    <div class="mx-auto max-w-6xl px-4 py-10 md:px-8 md:py-16">
      <p class={eyebrowClass}>Real jobs</p>
      <h1 class="mt-2 text-4xl tracking-tight md:text-6xl">Projects</h1>
      <p class="mt-4 max-w-prose text-lg">
        Photos from our jobs, a lot of them taken part-way through the work.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 md:px-8 md:py-16" aria-label="Project photos">
    <Gallery projects={projects} eager={2} />
  </section>

  <section class="bg-pale">
    <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-12 sm:flex-row sm:items-center sm:justify-between md:px-8">
      <h2 class="text-2xl tracking-tight md:text-3xl">Have a job like these?</h2>
      <div class="grid gap-3 sm:flex">
        <a href={quoteLink.href} class={primaryClass}>Get a quote</a>
        <a href={telHref} class={secondaryClass}>Call {business.phone.display}</a>
      </div>
    </div>
  </section>
</Base>
