---
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import { business, telHref } from "../data/business";
import { quoteLink } from "../data/navigation";
import { projectByFile } from "../data/projects";
import { leadServices, secondaryServices } from "../data/services";

const eyebrowClass = "font-heading text-sm font-bold uppercase tracking-[0.2em] text-accent";
const primaryClass =
  "inline-flex min-h-tap items-center justify-center rounded-brand bg-navy px-6 py-3 font-heading font-bold uppercase text-ground no-underline";
const secondaryClass =
  "inline-flex min-h-tap items-center justify-center rounded-brand border-2 border-navy px-6 py-3 font-heading font-bold uppercase text-navy no-underline";
const trades = [...leadServices, ...secondaryServices].map((service) => service.name);
const photo = projectByFile("plastered-room-with-tools.jpg");
---

<Base
  title={`About ${business.owner} | ${business.name}`}
  description={`${business.owner} is a sole trader with over 25 years in plastering, decorating and related trades across Birmingham and Worcestershire.`}
>
  <section class="bg-pale">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 md:grid-cols-2 md:items-center md:gap-12 md:px-8 md:py-16">
      <div class="min-w-0">
        <p class={eyebrowClass}>About</p>
        <h1 class="mt-2 text-4xl tracking-tight md:text-6xl">Meet {business.ownerFirstName}</h1>
        <p class="mt-4 max-w-prose text-lg">
          {business.name} is {business.owner}, a sole trader with over 25 years in plastering, painting and decorating,
          gardening and related trades.
        </p>
        <p class="mt-4 max-w-prose text-lg">We work across Birmingham, Worcestershire and Evesham.</p>
      </div>
      <div class="min-w-0 w-full md:max-w-sm md:justify-self-end">
        <Picture
          src={photo.image}
          alt={photo.alt}
          formats={["avif", "webp"]}
          widths={[400, 640, 800]}
          width={800}
          sizes="(min-width: 48rem) 24rem, 100vw"
          loading="eager"
          class="aspect-[4/5] w-full rounded-brand object-cover"
        />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 md:px-8 md:py-16" aria-labelledby="trades">
    <h2 id="trades" class="text-3xl tracking-tight md:text-4xl">What we do</h2>
    <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {trades.map((trade) => <li class="rounded-brand bg-pale px-4 py-3 font-semibold text-navy">{trade}</li>)}
    </ul>
    <div class="mt-6 flex flex-wrap gap-x-6">
      <a href="/services" class="inline-flex min-h-tap items-center font-bold">See our services</a>
      <a href="/projects" class="inline-flex min-h-tap items-center font-bold">See our projects</a>
    </div>
  </section>

  <section class="bg-pale">
    <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-12 sm:flex-row sm:items-center sm:justify-between md:px-8">
      <h2 class="text-2xl tracking-tight md:text-3xl">Talk to us about your job</h2>
      <div class="grid gap-3 sm:flex">
        <a href={quoteLink.href} class={primaryClass}>Get a quote</a>
        <a href={telHref} class={secondaryClass}>Call {business.phone.display}</a>
      </div>
    </div>
  </section>
</Base>
