---
import Base from "../../layouts/Base.astro";
import { business, telHref } from "../../data/business";
import { quoteLink } from "../../data/navigation";
import { areaHref, areas, type Area } from "../../data/areas";
import { leadServices, serviceHref } from "../../data/services";

export function getStaticPaths() {
  return areas.map((area) => ({ params: { slug: area.slug }, props: { area } }));
}

interface Props {
  area: Area;
}

const { area } = Astro.props;
const others = areas.filter((entry) => entry.slug !== area.slug);
const [lead, ...rest] = area.copy;
const eyebrowClass = "font-heading text-sm font-bold uppercase tracking-[0.2em] text-accent";
const primaryClass =
  "inline-flex min-h-tap items-center justify-center rounded-brand bg-navy px-6 py-3 font-heading font-bold uppercase text-ground no-underline";
const secondaryClass =
  "inline-flex min-h-tap items-center justify-center rounded-brand border-2 border-navy px-6 py-3 font-heading font-bold uppercase text-navy no-underline";
---

<Base title={area.title} description={area.description} localBusiness={{ areas: [area.name] }}>
  <div data-area-copy>
    <section class="bg-pale">
      <div class="mx-auto max-w-6xl px-4 py-10 md:px-8 md:py-16">
        <p class={eyebrowClass}><a href="/areas" class="inline-flex min-h-tap items-center">Areas</a></p>
        <h1 class="mt-1 text-4xl tracking-tight md:text-6xl">{area.name}</h1>
        <p class="mt-2 font-semibold text-navy">{area.region}</p>
        <p class="mt-4 max-w-prose text-lg">{lead}</p>
        <div class="mt-6 grid gap-3 sm:flex sm:flex-wrap">
          <a href={quoteLink.href} class={primaryClass}>Get a quote</a>
          <a href={telHref} class={secondaryClass}>Call {business.phone.display}</a>
        </div>
      </div>
    </section>

    <section class="mx-auto grid max-w-6xl gap-10 px-4 py-12 md:grid-cols-[2fr_1fr] md:px-8 md:py-16" aria-labelledby="work">
      <div class="min-w-0">
        <h2 id="work" class="text-3xl tracking-tight md:text-4xl">Work in {area.name}</h2>
        {rest.map((paragraph) => <p class="mt-4 max-w-prose text-lg">{paragraph}</p>)}
      </div>
      <nav aria-label="Services">
        <p class="font-bold text-navy">Services</p>
        <ul class="mt-2 grid gap-1">
          {
            leadServices.map((service) => (
              <li>
                <a href={serviceHref(service)} class="inline-flex min-h-tap items-center font-semibold">
                  {service.name}
                </a>
              </li>
            ))
          }
          <li>
            <a href="/services" class="inline-flex min-h-tap items-center font-semibold">All services</a>
          </li>
        </ul>
      </nav>
    </section>
  </div>

  <section class="bg-pale">
    <div class="mx-auto grid max-w-6xl gap-6 px-4 py-12 md:grid-cols-2 md:items-start md:px-8">
      <div>
        <h2 class="text-2xl tracking-tight md:text-3xl">Get a quote in {area.name}</h2>
        <div class="mt-4 grid gap-3 sm:flex sm:flex-wrap">
          <a href={quoteLink.href} class={primaryClass}>Get a quote</a>
          <a href={telHref} class={secondaryClass}>Call {business.phone.display}</a>
        </div>
      </div>
      <nav aria-label="Other areas">
        <p class="font-bold text-navy">Other areas</p>
        <ul class="mt-2 grid gap-x-6 sm:grid-cols-2">
          {
            others.map((other) => (
              <li>
                <a href={areaHref(other)} class="inline-flex min-h-tap items-center font-semibold">
                  {other.name}
                </a>
              </li>
            ))
          }
          <li>
            <a href="/areas" class="inline-flex min-h-tap items-center font-semibold">All areas</a>
          </li>
        </ul>
      </nav>
    </div>
  </section>
</Base>
