---
import "../../styles/motion.css";
import Base from "../../layouts/Base.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import { business, telHref } from "../../data/business";
import { quoteLink } from "../../data/navigation";
import { leadServices, secondaryServices, serviceHref } from "../../data/services";

const eyebrowClass = "font-heading text-sm font-bold uppercase tracking-[0.2em] text-accent";
const primaryClass =
  "inline-flex min-h-tap items-center justify-center rounded-brand bg-navy px-6 py-3 font-heading font-bold uppercase text-ground no-underline";
const secondaryClass =
  "inline-flex min-h-tap items-center justify-center rounded-brand border-2 border-navy px-6 py-3 font-heading font-bold uppercase text-navy no-underline";
---

<Base
  title={`Services | ${business.name}`}
  description={`Plastering, painting and decorating, gardening, kitchen fitting, carpentry and loft conversions from ${business.name}.`}
>
  <section class="bg-pale">
    <div class="mx-auto max-w-6xl px-4 py-10 md:px-8 md:py-16">
      <p class={eyebrowClass}>What we do</p>
      <h1 class="mt-2 text-4xl tracking-tight md:text-6xl">Services</h1>
      <p class="mt-4 max-w-prose text-lg">
        We've got over 25 years in the trade. Plastering, decorating and gardening are our main work, and we
        take on the related jobs below too.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 md:px-8 md:py-20" aria-labelledby="lead-services">
    <h2 id="lead-services" class="text-3xl tracking-tight md:text-4xl">Main services</h2>
    <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        leadServices.map((service) => (
          <li data-motion="rise">
            <ServiceCard service={service} href={serviceHref(service)} />
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-12 md:px-8 md:pb-20" aria-labelledby="secondary-services">
    <h2 id="secondary-services" class="text-3xl tracking-tight md:text-4xl">Also available</h2>
    <p class="mt-3 max-w-prose">Just ask about these when you get in touch for a quote.</p>
    <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        secondaryServices.map((service) => (
          <li data-motion="rise">
            <ServiceCard service={service} />
          </li>
        ))
      }
    </ul>
  </section>

  <section class="bg-pale">
    <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-12 sm:flex-row sm:items-center sm:justify-between md:px-8">
      <h2 class="text-2xl tracking-tight md:text-3xl">Have a job in mind?</h2>
      <div class="grid gap-3 sm:flex">
        <a href={quoteLink.href} data-motion="fill" class={primaryClass}>Get a quote</a>
        <a href={telHref} class={secondaryClass}>Call {business.phone.display}</a>
      </div>
    </div>
  </section>
</Base>
