---
import { Picture } from "astro:assets";
import Base from "../../layouts/Base.astro";
import { business, telHref } from "../../data/business";
import { quoteLink } from "../../data/navigation";
import { leadServices, serviceHref, type LeadService } from "../../data/services";

export function getStaticPaths() {
  return leadServices.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

interface Props {
  service: LeadService;
}

const { service } = Astro.props;
const others = leadServices.filter((entry) => entry.slug !== service.slug);
const eyebrowClass = "font-heading text-sm font-bold uppercase tracking-[0.2em] text-accent";
const primaryClass =
  "inline-flex min-h-tap items-center justify-center rounded-brand bg-navy px-6 py-3 font-heading font-bold uppercase text-ground no-underline";
const secondaryClass =
  "inline-flex min-h-tap items-center justify-center rounded-brand border-2 border-navy px-6 py-3 font-heading font-bold uppercase text-navy no-underline";
---

<Base title={service.title} description={service.description} image={service.photo.image} imageAlt={service.photo.alt}>
  <section class="bg-pale">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 md:grid-cols-2 md:items-center md:gap-12 md:px-8 md:py-16">
      <div class="min-w-0">
        <p class={eyebrowClass}><a href="/services" class="inline-flex min-h-tap items-center">Services</a></p>
        <h1 class="mt-1 text-4xl tracking-tight md:text-6xl">{service.name}</h1>
        {service.intro.map((paragraph) => <p class="mt-4 max-w-prose text-lg">{paragraph}</p>)}
        <div class="mt-6 grid gap-3 sm:flex sm:flex-wrap">
          <a href={quoteLink.href} class={primaryClass}>Get a quote</a>
          <a href={telHref} class={secondaryClass}>Call {business.phone.display}</a>
        </div>
      </div>
      <Picture
        src={service.photo.image}
        alt={service.photo.alt}
        formats={["avif", "webp"]}
        widths={[480, 800, 1200]}
        width={1200}
        sizes="(min-width: 72rem) 34rem, (min-width: 48rem) 50vw, 100vw"
        loading="eager"
        fetchpriority="high"
        class="aspect-[4/3] w-full rounded-brand object-cover"
      />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 md:px-8 md:py-16" aria-labelledby="includes">
    <h2 id="includes" class="text-3xl tracking-tight md:text-4xl">What we do</h2>
    <ul class="mt-6 grid gap-3 sm:grid-cols-2">
      {
        service.includes.map((item) => (
          <li class="flex items-center gap-3 rounded-brand bg-pale px-4 py-3 font-semibold text-navy">
            <svg class="size-5 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12l5 5 9-10"></path>
            </svg>
            {item}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-12 md:px-8 md:pb-16" aria-labelledby="work">
    <h2 id="work" class="text-3xl tracking-tight md:text-4xl">Recent {service.name.toLowerCase()} work</h2>
    <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        service.photos.map((project) => (
          <li>
            <Picture
              src={project.image}
              alt={project.alt}
              formats={["avif", "webp"]}
              widths={[400, 640, 800]}
              width={800}
              sizes="(min-width: 64rem) 22rem, (min-width: 40rem) 50vw, 100vw"
              loading="lazy"
              class="aspect-[4/3] w-full rounded-brand object-cover"
            />
          </li>
        ))
      }
    </ul>
    <a href="/projects" class="mt-6 inline-flex min-h-tap items-center font-bold">See every project</a>
  </section>

  <section class="bg-pale">
    <div class="mx-auto grid max-w-6xl gap-6 px-4 py-12 md:grid-cols-2 md:items-center md:px-8">
      <div>
        <h2 class="text-2xl tracking-tight md:text-3xl">Have a job in mind?</h2>
        <div class="mt-4 grid gap-3 sm:flex sm:flex-wrap">
          <a href={quoteLink.href} class={primaryClass}>Get a quote</a>
          <a href={telHref} class={secondaryClass}>Call {business.phone.display}</a>
        </div>
      </div>
      <nav aria-label="Other services">
        <p class="font-bold text-navy">Other services</p>
        <ul class="mt-2 grid gap-1">
          {
            others.map((other) => (
              <li>
                <a href={serviceHref(other)} class="inline-flex min-h-tap items-center font-semibold">
                  {other.name}
                </a>
              </li>
            ))
          }
          <li>
            <a href="/services" class="inline-flex min-h-tap items-center font-semibold">All services</a>
          </li>
        </ul>
      </nav>
    </div>
  </section>
</Base>
