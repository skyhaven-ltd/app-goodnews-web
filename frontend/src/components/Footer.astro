---
import { PLACEHOLDER, business, telHref } from "../data/business";
import { buildWhatsAppUrl } from "../lib/quote";
import { homeLink, isCurrent, legalNav, mainNav, quoteLink, serviceNav } from "../data/navigation";

const path = Astro.url.pathname;
const whatsappHref = buildWhatsAppUrl(business.whatsapp, "Hi, I'd like a quote please.");
const year = new Date().getFullYear();
const headingClass = "font-heading text-sm font-bold uppercase tracking-wide text-baby";
const linkClass = "inline-flex min-h-tap min-w-tap items-center text-ground no-underline hover:underline aria-[current=page]:underline";
const groups = [
  { title: "Pages", links: [homeLink, ...mainNav, quoteLink] },
  { title: "Services", links: serviceNav },
];
---

<footer class="bg-navy px-4 pb-8 pt-10 text-ground md:px-8 md:pt-14">
  <div class="mx-auto grid max-w-6xl gap-8 sm:grid-cols-2 md:grid-cols-4">
    <div class="sm:col-span-2 md:col-span-1">
      <p class="font-heading text-lg font-extrabold uppercase tracking-wide">{business.name}</p>
      <p class="mt-2 text-pale">Plastering, painting and decorating, and gardening across Birmingham, Worcestershire and Evesham.</p>
    </div>
    {
      groups.map((group) => (
        <nav aria-label={group.title}>
          <h2 class={headingClass}>{group.title}</h2>
          <ul class="mt-2">
            {group.links.map((link) => (
              <li>
                <a href={link.href} class={linkClass} aria-current={isCurrent(link.href, path) ? "page" : undefined}>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
    <div>
      <h2 class={headingClass}>Contact</h2>
      <ul class="mt-2">
        <li>
          <a href={telHref} class={linkClass}>{business.phone.display}</a>
        </li>
        <li>
          <a href={whatsappHref} class={linkClass}>WhatsApp us</a>
        </li>
        {
          business.email !== PLACEHOLDER && (
            <li>
              <a href={`mailto:${business.email}`} class={linkClass}>
                {business.email}
              </a>
            </li>
          )
        }
      </ul>
    </div>
  </div>
  <div class="mx-auto mt-8 flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-2 border-t border-accent pt-4 text-pale">
    <p>&copy; {year} {business.name}</p>
    <ul class="flex gap-4">
      {
        legalNav.map((link) => (
          <li>
            <a href={link.href} class={linkClass} aria-current={isCurrent(link.href, path) ? "page" : undefined}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
