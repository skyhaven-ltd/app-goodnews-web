---
import { business, telHref } from "../data/business";
import { quoteLink } from "../data/navigation";
import { buildWhatsAppUrl } from "../lib/quote";

const whatsappHref = buildWhatsAppUrl(business.whatsapp, "Hi, I'd like a quote please.");
const itemClass =
  "flex h-14 flex-col items-center justify-center gap-0.5 font-heading text-base font-bold uppercase leading-tight tracking-wide no-underline";
---

<nav
  aria-label="Contact"
  class="fixed inset-x-0 bottom-0 z-40 border-t border-line bg-ground pb-[env(safe-area-inset-bottom)] md:hidden"
>
  <ul class="grid grid-cols-3">
    <li>
      <a href={telHref} class:list={[itemClass, "bg-navy text-ground"]}>
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"></path>
        </svg>
        <span>Call</span>
      </a>
    </li>
    <li>
      <a href={whatsappHref} class:list={[itemClass, "bg-baby text-navy"]}>
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 21l1.65-3.8A9 9 0 1 1 7.8 20.3L3 21"></path>
        </svg>
        <span>WhatsApp</span>
      </a>
    </li>
    <li>
      <a href={quoteLink.href} class:list={[itemClass, "bg-pale text-navy"]}>
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9l-6-6zM14 3v6h6M8 13h8M8 17h5"></path>
        </svg>
        <span>Quote</span>
      </a>
    </li>
  </ul>
</nav>
