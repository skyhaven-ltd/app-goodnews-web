---
import { getImage } from "astro:assets";
import { business } from "../data/business";
import { normalisePath } from "../data/navigation";
import { buildLocalBusiness, serializeJsonLd } from "../lib/jsonld";
import { projects } from "../data/projects";

export interface LocalBusinessPage {
  areas?: readonly string[];
}

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  imageAlt?: string;
  noindex?: boolean;
  localBusiness?: LocalBusinessPage;
}

const fallback = projects.find((project) => project.file === "plastered-loft-room.jpg") ?? projects[0];
const {
  title,
  description,
  image = fallback.image,
  imageAlt = fallback.alt,
  noindex = false,
  localBusiness,
} = Astro.props;

if (!Astro.site) {
  throw new Error("Set site in astro.config.mjs");
}

const canonical = new URL(normalisePath(Astro.url.pathname), Astro.site).href;
const ogImage = await getImage({ src: image, width: 1200, height: 630, fit: "cover", format: "jpg" });
const ogImageUrl = new URL(ogImage.src, Astro.site).href;
const jsonLd =
  localBusiness &&
  serializeJsonLd(
    buildLocalBusiness({ site: Astro.site, page: canonical, areas: localBusiness.areas, image: ogImageUrl, description }),
  );
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}
<meta property="og:type" content="website" />
<meta property="og:locale" content="en_GB" />
<meta property="og:site_name" content={business.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
